<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="external_repair_quotation_report">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)" />
                        <t t-set="information_block">
                            <!--<strong t-if="o.address_id == o.partner_invoice_id">Invoice and shipping address:</strong>-->
                            <br />
                            <br />
                            <br />
                            <br />
                            <br />
                            <br />
                            <br />
                            <br />
                            <div t-if="o.partner_invoice_id">
                                <strong t-if="o.address_id != o.partner_invoice_id">Invoice address: </strong>
                                <div t-field="o.partner_invoice_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;,&quot;vat&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}" />
                                <t t-if="o.ticket_id">
                                    <t t-if="o.ticket_id.partner_name">
                                        <div>
                                            <!-- <i class="fa fa-name" /> -->
                                            <span t-esc="o.ticket_id.partner_name" style="padding-left:5px;" />
                                        </div>
                                    </t>
                                    <t t-if="o.ticket_id.partner_phone">
                                        <div>
                                            <i class="fa fa-phone"></i>
                                            <span t-esc="o.ticket_id.partner_phone" style="padding-left:5px;"></span>
                                        </div>
                                    </t>
                                    <t t-if="o.ticket_id.partner_email">
                                        <div>
                                            <i class="fa fa-envelope"></i>
                                            <span t-esc="o.ticket_id.partner_email" style="padding-left:5px;"></span>
                                        </div>
                                    </t>
                                    <t t-if="o.ticket_id">
                                        <t t-if="o.ticket_id.partner_id">
                                            <t t-if="o.ticket_id.address_print() != o.ticket_id.address">
                                                <div>
                                                    <span t-esc="o.ticket_id.address" style="padding-left:5px;" />
                                                </div>
                                            </t>
                                        </t>
                                    </t>
                                </t>
                            </div>
                        </t>
                        <t t-set="address">
                            <br />
                            <br />
                            <br />
                            <br />
                            <br />
                            <br />
                            <br />
                            <br />
                            <div t-field="o.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot; &quot;email&quot; ,&quot;phone&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}" />
                        </t>
                        <div class="page">
                            <div class="oe_structure" />
                            <h2>
                                <span t-if="o.state != 'draft'">Repair Order #:</span>
                                <span t-if="o.state == 'draft'">Repair Quotation #:</span>
                                <span t-field="o.name" />
                            </h2>
                            <div id="informations" class="row mt32 mb32">
                                <div style="margin-top :5px;" t-if="o.product_id.name" class="col-auto col-3 mw-100 mb-2">
                                    <strong>Product to Repair:</strong>
                                    <p t-field="o.product_id.name" class="m-0" />
                                </div>
                                <t t-if="o.lot_id">
                                    <div style="margin-top :5px;" class="col-auto col-3 mw-100 mb-2" groups="stock.group_production_lot">
                                        <strong>Lot/Serial Number:</strong>
                                        <span t-field="o.lot_id.name" />
                                    </div>
                                </t>
                                <div style="margin-top :5px;" t-if="o.guarantee_limit" class="col-auto col-3 mw-100 mb-2">
                                    <strong>Warranty:</strong>
                                    <p t-field="o.guarantee_limit" class="m-0" />
                                </div>
                                <div style="margin-top :5px;" t-if="o.ticket_id" class="col-auto col-3 mw-100 mb-2">
                                    <strong>Ticket:</strong>
                                    <p t-field="o.ticket_id" class="m-0" />
                                </div>
                                <div style="margin-top :5px;" t-if="o.description" class="col-auto col-3 mw-100 mb-2">
                                    <strong>Repair Description:</strong>
                                    <p t-field="o.description" class="m-0" />
                                </div>
                                <div style="margin-top :5px;" t-if="o.create_date" class="col-auto col-3 mw-100 mb-2">
                                    <strong>Date:</strong>
                                    <p class="m-0"
                                        t-esc="o.create_date and o.create_date.strftime('%Y-%m-%d')"/>
                                </div>
                            </div>
                            <table class="table table-sm o_main_table">
                                <thead>
                                    <tr>
                                        <th>Description</th>
                                        <th class="text-end">Quantity</th>
                                        <t t-if="o.invoice_method != 'none'">
                                            <th class="text-end">Unit Price</th>
                                            <th class="text-center">Tax</th>
                                            <th class="text-end">Price</th>
                                        </t>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="parts_total" t-value="0"> </t>
                                    <t t-set="parts_subtotal" t-value="0"> </t>
                                    <t t-set="all_tax_total" t-value="0"> </t>
                                    <t t-if="o.operations">
                                        <t t-foreach="o.operations" t-as="line">
                                            <t t-set="parts_total" t-value="parts_total+line.price_total"> </t>
                                            <t t-set="parts_subtotal" t-value="parts_subtotal+line.price_subtotal"> </t>
                                            <t t-set="all_tax_total" t-value="all_tax_total+(line.price_total-line.price_subtotal)"> </t>
                                        </t>
                                    </t>
                                    <t t-if="o.fees_lines">
                                        <tr class="bg-200 o_line_section">
                                            <td colspan="5"><strong>Operations</strong></td>
                                        </tr>
                                        <tr t-foreach="o.fees_lines" t-as="fees">
                                            <td>
                                                <span t-field="fees.name" />
                                            </td>
                                            <td class="text-end">
                                                <span t-field="fees.product_uom_qty" />
                                                <span groups="uom.group_uom" t-field="fees.product_uom.name" />
                                            </td>
                                            <t t-if="(fees.repair_id.invoice_method != 'none')">
                                                <td class="text-end">
                                                    <span t-field="fees.price_unit" />
                                                </td>
                                                <td class="text-center">
                                                    <span t-esc="','.join(map( lambda x: x.description or x.name, fees.tax_id))" />
                                                </td>
                                                <td class="text-end o_price_total">
                                                    <span t-field="fees.price_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.pricelist_id.currency_id}" />
                                                </td>
                                            </t>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                            <div id="total" class="row justify-content-end">
                                <div class="col-4">
                                    <table class="table table-sm">
                                        <t t-if="o.invoice_method !='none'">
                                            <tr class="border-black o_subtotal">
                                                <td><strong>Total Without Taxes</strong></td>
                                                <td class="text-end">
                                                    <span t-esc="o.amount_untaxed - parts_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.pricelist_id.currency_id}" />
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>Taxes</td>
                                                <td class="text-end o_price_total">
                                                    <span t-esc="o.amount_tax - all_tax_total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.pricelist_id.currency_id}" />
                                                </td>
                                            </tr>
                                            <tr class="border-black o_total">
                                                <td><strong>Total</strong></td>
                                                <td class="text-end o_price_total">
                                                    <span t-esc="o.amount_total - parts_total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.pricelist_id.currency_id}" />
                                                </td>
                                            </tr>
                                        </t>
                                    </table>
                                </div>
                            </div>
                            <p t-field="o.quotation_notes" />
                            <div class="oe_structure" />
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>