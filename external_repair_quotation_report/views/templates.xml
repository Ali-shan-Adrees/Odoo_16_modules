<?xml version="1.0"?>
<odoo>
    <data>
        <record id="external_repair_quotation_report_paper_format" model="report.paperformat">
            <field name="name">External Repair Quotaion Report</field>
            <field name="default" eval="True"/>
            <field name="format">custom</field>
            <field name="page_height">330</field>
            <field name="page_width">200</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">10</field>
            <field name="margin_bottom">0</field>
            <field name="margin_left">4</field>
            <field name="margin_right">4</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
            <field name="dpi">90</field>
        </record>

        <report
            id="external_repair_quotation_report_id"
            model="repair.order"
            name="external_repair_quotation_report.external_repair_quotation_report"
            file="external_repair_quotation_report.external_repair_quotation_report"
            report_type="qweb-pdf"
            string="External Repair Quotation"
            paperformat="external_repair_quotation_report_paper_format"
          />
    </data>
</odoo>